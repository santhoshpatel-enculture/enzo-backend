# Enzo Backend - Configuration
# Copy this file to .env and fill in your values.

# MongoDB
MONGO_URI=mongodb://127.0.0.1:27017
MONGO_DB_NAME=enzo_db

# JWT - Generate a strong secret: python -c "import secrets; print(secrets.token_hex(32))"
# Do NOT use default values in production.
JWT_SECRET_KEY=
JWT_ALGORITHM=HS256
JWT_EXPIRATION_MINUTES=1440
JWT_ACCESS_EXPIRATION_MINUTES=15
JWT_REFRESH_EXPIRATION_DAYS=7
REFRESH_COOKIE_SECURE=false
REFRESH_COOKIE_DOMAIN=

# Microsoft Entra SSO (optional)
OIDC_MICROSOFT_CLIENT_ID=
OIDC_MICROSOFT_CLIENT_SECRET=
OIDC_MICROSOFT_TENANT_ID=common
OIDC_MICROSOFT_REDIRECT_URI=http://localhost:8000/api/auth/sso/microsoft/callback
FRONTEND_URL=http://localhost:5173
ADMIN_FRONTEND_URL=http://localhost:5174

# Groq LLM (primary provider option)
GROQ_API_KEY=
GROQ_MODEL=llama3-8b-8192

# OpenAI LLM (fallback — e.g. gpt-4o-mini, set in admin Chatbot tab)
OPENAI_API_KEY=

# Application
APP_ENV=development
# Comma-separated frontend origins (no wildcards; include https://, no trailing slash)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:5174,http://127.0.0.1:5174,http://localhost:5175,http://127.0.0.1:5175,https://enzo-enculture.vercel.app,https://enzo-admin.vercel.app

# Admin console (comma-separated emails allowed to use Enzo-admin)
ADMIN_EMAILS=admin@enculture.ai,santhosh@enculture.ai
# Local: uploads/kb — Vercel sets /tmp/enzo-kb automatically when VERCEL=1
ADMIN_UPLOAD_DIR=uploads/kb
ADMIN_MAX_UPLOAD_MB=10
# Max users returned by admin list (0 = no limit)
ADMIN_USERS_LIST_LIMIT=0
